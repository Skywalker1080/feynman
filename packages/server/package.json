{
  "name": "@feynman/server",
  "version": "0.1.0",
  "description": "Agent server for the Feynman terminal coding agent",
  "license": "MIT",
  "author": "Pranav",
  "homepage": "https://github.com/feynman-agent/feynman#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/feynman-agent/feynman.git",
    "directory": "packages/server"
  },
  "keywords": [
    "feynman",
    "coding-agent",
    "ai",
    "llm",
    "server",
    "lmstudio",
    "openrouter"
  ],
  "main": "./dist/index.js",
  "bin": {
    "feynman-server": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npx tsup",
    "dev": "npx tsup --watch",
    "typecheck": "npx tsc --noEmit",
    "lint": "npx eslint src",
    "test": "npx vitest run",
    "test:watch": "npx vitest",
    "clean": "npx rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^0.1.9",
    "@feynman/types": "*",
    "@openrouter/ai-sdk-provider": "^0.4.3",
    "ai": "^4.3.16",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "gray-matter": "^4.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
