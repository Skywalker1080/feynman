{
  "name": "feynman-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npx turbo build",
    "start": "node packages/client/dist/index.js",
    "server": "node packages/server/dist/index.js",
    "dev:server": "npx turbo dev --filter=@feynman/server",
    "dev:client": "npx turbo dev --filter=feynman",
    "lint": "npx turbo lint",
    "typecheck": "npx turbo typecheck",
    "test": "npx vitest run",
    "clean": "npx turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\" --ignore-path .prettierignore",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.8.2"
}
